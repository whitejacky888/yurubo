{
  "name": "yurubo-functions",
  "private": true,
  "description": "ゆる募のサーバー側の処理（Cloud Functions for Firebase）",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/**/*.test.ts",
    "serve": "npm run build && firebase emulators:start",
    "deploy": "firebase deploy --only functions",
    "test:integration": "node --test --test-concurrency=1 --import tsx test/integration.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}