# このファイルを .env という名前でコピーして使います（.env は Git に入れません）
#
# 1 にすると、本物の Firebase ではなく、パソコンで動かす Firebase エミュレーターにつながります。
# 本物の SMS を送らずにログインを試せます（コードはエミュレーターの画面 http://localhost:4000 に出ます）。
EXPO_PUBLIC_USE_EMULATOR=0

# 実機（本物のスマホ）でエミュレーターにつなぐときは、パソコンの IP アドレスを書きます。
# 例：EXPO_PUBLIC_EMULATOR_HOST=192.168.0.10
# EXPO_PUBLIC_EMULATOR_HOST=
